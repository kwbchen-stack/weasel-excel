+static std::wstring FormatCount(long long n) {
+  std::wstring digits = std::to_wstring(n < 0 ? -n : n);
+  std::wstring out;
+  int count = 0;
+  for (auto it = digits.rbegin(); it != digits.rend(); ++it) {
+    if (count && count % 3 == 0)
+      out.insert(out.begin(), L',');
+    out.insert(out.begin(), *it);
+    ++count;
+  }
+  return n < 0 ? L"-" + out : out;
+}
