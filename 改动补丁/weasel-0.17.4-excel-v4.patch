+void WeaselServerApp::CustomizeTrayMenu(HMENU menu) {
+  bool pinyin = false, single_char = false, horizontal = false;
+  m_server.WithApiLock([&] {
+    pinyin = m_handler->IsPinyinMode();
+    single_char = m_handler->IsSingleChar();
